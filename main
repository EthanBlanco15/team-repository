#lst_band_names is a list that stores the name of each band
#lst_artists is a list that stores all the names of the artists that belong to a band
#band is a variable used to append information to lst_band_names
#artists is a variable used to append information to lst_artists
#artmanagment_backtrack is used to tell wether its the users first time going through the program. if it is, they will go through standard artist managment, if not they will have a few more options like modifying their artists, or creating new lists.

#the lst_venus list im using in the add_artist_func should be switched out if needed, please let me know if you need assistance -mark
#the lst_timeslots list im using in the add_artist_func should be switched out if needed, please let me know if you need assistance -mark
#stages is a variable used to append information to lst_venus. 
#time is a variable used to append information to lst_timeslots

#we should include adding a timeslot, and venu to the artists in the add_artist_func


#these lists are created outside any functions so that everyone is able to use them

lst_band_names = []
lst_artists = []
lst_venus = []
lst_timeslots = []




#this adds artists to a list along with venues and timeslots
def add_band_func(lst_band_names, lst_artists, lst_venus, lst_timeslots):
    for i in range(int(input(f"\nHow many bands would you like to add? "))):
        band = input(f"\nWhat is the name of band {i+1}? ")
        lst_band_names.append(band)
        artists = str(input(f"\nWhat are the names of the artists in the band {band}? (format as: artist 1, artist 2, artist 3): "))
        lst_artists.append(artists)
        stages = input(f"\nWhat stage will {band} Occupy? ")
        lst_venus.append(stages)
        time = int(0)
        while type(time) == int:
            time = input(f"\nWhat time will the band '{band}' arrive on stage {stages}? (format as: [][]:[][] AM/PM) ")
            try:
                time = int(time)
                print("\nplease put the time in as the format provided, [][]:[][] AM/PM, heres an example 10:26 PM ")
            except:
                print(" ")
        lst_timeslots.append(time)
    for i in range(len(lst_band_names)):
        print(f"\n{lst_band_names[i]} with artists, {lst_artists[i]} will be on stage {lst_venus[i]}, at {lst_timeslots[i]}")
        

#main function        
def main():
    selection = 0
    while selection > 6 or selection < 1:
        try:
            selection = int(input("\nWhere would you like to go?\n\n(1) Artist managment\n\n(2-5) WIP\n\n(6) Search for an artist\n\nPlease type the number of your option: "))
            if selection > 3 or selection < 1:
                print("\nPlease select only 1, 2, or 3\n")
        except:
            print("\nPlease only enter a whole number.")
    if selection == 1:
        if artmanagment_backtrack == 1:
            print('wip')
        else:
            add_band_func(lst_band_names, lst_artists, lst_venus, lst_timeslots)
        artmanagment_backtrack = 1

if __name__ == "__main__":
    main()
