#main function        
def main():
    while True:
        selection = 0
        while selection > 6 or selection < 1:
            try:
                selection = int(input("\nWhere would you like to go?\n\n(1) Artist managment\n\n(2-5) WIP\n\n(6) Search for an artist\n\nPlease type the number of your option: "))
                if selection > 3 or selection < 1:
                    print("\nPlease select only 1, 2, or 3\n")
            except:
                print("\nPlease only enter a whole number.")
        if selection == 1:
            try:
                if artmanagment_backtrack == 1:
                    print('wip')
            except:
                add_band_func(lst_band_names, lst_artists, lst_venus, lst_timeslots, dict_lists)
