#these lists are created outside any functions so that everyone is able to use them

dict_lists = {} #add in
lst_band_names = []
lst_artists = []
lst_venus = []
lst_timeslots = []




#this adds artists to a list along with venues and timeslots
def add_band_func(lst_band_names, lst_artists, lst_venus, lst_timeslots, dict_lists):
    for i in range(int(input(f"\nHow many bands would you like to add? "))):
        band = input(f"\nWhat is the name of band {i+1}? ")
        lst_band_names.append(band)
        artists = str(input(f"\nWhat are the names of the artists in the band {band}? (format as: artist 1, artist 2, artist 3): "))
        lst_artists.append(artists)
        stages = input(f"\nWhat stage will {band} Occupy? ")
        lst_venus.append(stages)
        time = int(0)
        while type(time) == int:
            time = input(f"\nWhat time will the band '{band}' arrive on stage {stages}? (format as: [][]:[][] AM/PM) ")
            try:
                time = int(time)
                print("\nplease put the time in as the format provided, [][]:[][] AM/PM, heres an example 10:26 PM ")
            except:
                print(" ")
        lst_timeslots.append(time)
    for i in range(len(lst_band_names)):
        print(f"\n{lst_band_names[i]} with artists, {lst_artists[i]} will be on stage {lst_venus[i]}, at {lst_timeslots[i]}")
    return

#this allows modification, deletion, and creation of new lists
